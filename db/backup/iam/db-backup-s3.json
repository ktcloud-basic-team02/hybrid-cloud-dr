{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::beaver-backup-s3",
            "Condition": {
                "StringLike": {
                    "s3:prefix": "DB/*"
                }
            }
        },
        {
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::beaver-backup-s3/DB/*"
        }
    ]
}
